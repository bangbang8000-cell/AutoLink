{
  "name": "autolink",
  "version": "3.0.0",
  "description": "AutoLink - AI智算中心网络规划与可视化工具",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": {
    "name": "AutoLink Team",
    "email": "autolink@example.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "dev:all": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && node -e \"require('fs').renameSync('dist-electron/preload.js', 'dist-electron/preload.cjs')\" && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:all:clean": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build:electron": "node scripts/clean-dist.cjs && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && node scripts/rename-preload.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ electron/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ electron/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backend": "python -m pytest tests/backend/ -v",
    "test:backend:coverage": "python -m pytest tests/backend/ -v --cov=backend --cov-report=html",
    "test:all": "npm run test && npm run test:backend"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.2",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "electron-updater": "^6.6.2",
    "i18next": "^26.3.6",
    "lucide-react": "^1.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.autolink.app",
    "productName": "AutoLink",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bangbang8000-cell",
        "repo": "AutoLink"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "dist/backend-dist",
        "to": "backend-dist"
      },
      {
        "from": "template",
        "to": "template"
      },
      {
        "from": "build/logo.svg",
        "to": "branding/logo.svg"
      },
      {
        "from": "docs/v2.5/logo_specification.md",
        "to": "branding/logo_specification.md"
      },
      {
        "from": "docs/user_guide",
        "to": "docs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AutoLink"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "artifactName": "${productName}-${version}-linux.${ext}"
    }
  }
}
